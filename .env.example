# ============ API KEYS ============
# Configure as chaves dos providers que voce vai usar
# Voce so precisa configurar os providers que pretende utilizar

# DeepSeek (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# OpenAI GPT (https://platform.openai.com/)
OPENAI_API_KEY=

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# OpenRouter - Agregador de modelos (https://openrouter.ai/)
OPENROUTER_API_KEY=

# ============ CONVEX ============
# URL do site Convex (para webhooks e pricing dinâmico)
VITE_CONVEX_URL=https://seu-projeto.convex.cloud
VITE_CONVEX_SITE_URL=https://seu-projeto.convex.site

# ============ PROVIDER DE IA ============
# Provider padrão (anthropic | openai | deepseek | openrouter)
AI_PROVIDER=openrouter
