# ============ PROVIDER DE IA ============
# Opções: anthropic, openai, deepseek, kimi, openrouter
AI_PROVIDER=openrouter

# ============ API KEYS ============
# Configure apenas a chave do provider que você vai usar

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sua_chave_aqui

# OpenAI GPT (https://platform.openai.com/)
OPENAI_API_KEY=sua_chave_aqui

# DeepSeek (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=sua_chave_aqui

# Kimi / Moonshot AI (https://platform.moonshot.cn/)
KIMI_API_KEY=sua_chave_aqui

# OpenRouter - Agregador de modelos (https://openrouter.ai/)
OPENROUTER_API_KEY=sua_chave_aqui

# OpenRouter: Force specific provider (optional, leave empty for auto-routing)
# Together = US-based provider
# SiliconFlow = Alternative provider
# Leave empty to let OpenRouter choose automatically
OPENROUTER_PROVIDER=Together

# ============ MODELOS ============
# Modelos recomendados por provider:

# Anthropic: claude-opus-4-5 (melhor), claude-sonnet-4-5 (rápido), claude-haiku-4 (barato)
ANTHROPIC_MODEL=claude-opus-4-5

# OpenAI: gpt-4-turbo-preview, gpt-4, gpt-3.5-turbo
OPENAI_MODEL=gpt-4-turbo-preview

# DeepSeek: deepseek-chat, deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat

# Kimi: moonshot-v1-128k, moonshot-v1-32k
KIMI_MODEL=moonshot-v1-128k

# OpenRouter: Acesso a múltiplos modelos via uma única API
# Modelos disponíveis (exemplos):
#   - deepseek/deepseek-chat (R1, com reasoning)
#   - deepseek/deepseek-reasoner (R1 completo)
#   - anthropic/claude-opus-4-5 (via OpenRouter)
#   - anthropic/claude-sonnet-4-5
#   - openai/gpt-4-turbo
#   - x-ai/grok-2-1212
#   - google/gemini-2.0-flash-exp (grátis!)
#   - mistralai/mistral-large
#   - qwen/qwen-2.5-72b-instruct
#   - moonshot/moonshot-v1-128k (Kimi)
#   - together/kimi-k2.5
# Lista completa: https://openrouter.ai/models
OPENROUTER_MODEL=moonshotai/kimi-k2.5

# ============ EXTENDED THINKING ============
# Budget de thinking tokens por fase (quanto maior, mais profundo o raciocínio)
# Apenas para modelos que suportam: Anthropic Claude, DeepSeek Reasoner
ENABLE_THINKING=true
THINKING_BUDGET_FASE1=15000
THINKING_BUDGET_FASE2=12000
THINKING_BUDGET_FASE3=10000
THINKING_BUDGET_FASE4=15000

# ============ CONFIGURAÇÕES GERAIS ============
MAX_TOKENS=16000
TEMPERATURE=0.3
ENABLE_TOOLS=true

# ============ DIRETÓRIOS ============
INPUT_DIR=./data/input
OUTPUT_DIR=./data/output
LOGS_DIR=./logs
